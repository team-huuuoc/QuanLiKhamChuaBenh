generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  ADMIN
  SUPER_ADMIN
}
enum Gender {
  MALE
  FEMALE
  OTHER
}
enum PatientStatus {
  DANG_DIEU_TRI
  CHO_KHAM
  XUAT_VIEN
  NOI_TRU
}
enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

model User {
  id                Int      @id @default(autoincrement())
  name              String
  email             String?  @unique
  hashedPassword    String
  hashRefreshToken  String?
  role              Role     @default(ADMIN)
  phoneNumber       String?  @unique
  avatar            String?    
  gender            Gender?
  dateOfBirth       DateTime? 
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("users")
}
model Doctor {
  id         Int    @id @default(autoincrement())
  identify   String
  name       String
  specialty  String
  department String
  phone      String
  email      String    @unique
  experience Int
  status     EmploymentStatus   @default(ACTIVE)
  patients   Patient[]
}

model Nurse {
  id         Int    @id @default(autoincrement())
  identify   String
  name       String
  department String
  phone      String
  email      String    @unique
  shift      String
  experience Int
  status     EmploymentStatus   @default(ACTIVE)
  patients   Patient[]
}
model Patient {
  id               Int        @id @default(autoincrement())
  identify         String
  name             String
  dateOfBirth      DateTime
  gender           Gender
  phone            String
  address          String
  idNumber         String        @unique
  insurance        String?
  emergencyContact String
  createdAt        DateTime      @default(now())
  status           PatientStatus
  roomNumber       String?
  admissionDate    DateTime?
  notes            String?
  doctorId Int?
  nurseId  Int?

  doctor   Doctor?       @relation(fields: [doctorId], references: [id])
  nurse    Nurse?        @relation(fields: [nurseId], references: [id])
}